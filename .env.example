# Node Environment
NODE_ENV=production

# Database Configuration (PostgreSQL)
SQL_HOST=localhost
SQL_USER=dental_user
SQL_PASSWORD=dental_secure_password_123
SQL_DB_NAME=dental_db

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# Google OAuth 2.0 Client ID for Drive & Sheets Backup (Optional, for custom domain/Render deployment)
# Dạng: xxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
