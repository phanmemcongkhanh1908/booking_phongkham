rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidClinic(data) {
      return data.keys().hasAll(['slug', 'clinicName'])
        && data.keys().hasOnly([
          'slug', 'clinicName', 'doctorName', 'address', 'phone',
          'hotline', 'workingHours', 'workingHoursStr', 'slogan',
          'tenantId', 'updatedAt'
        ])
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.clinicName is string && data.clinicName.size() >= 1 && data.clinicName.size() <= 200
        && (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() <= 200))
        && (!('address' in data) || (data.address is string && data.address.size() <= 400))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('hotline' in data) || (data.hotline is string && data.hotline.size() <= 50))
        && (!('workingHours' in data) || (data.workingHours is string && data.workingHours.size() <= 200))
        && (!('workingHoursStr' in data) || (data.workingHoursStr is string && data.workingHoursStr.size() <= 200))
        && (!('slogan' in data) || (data.slogan is string && data.slogan.size() <= 300))
        && (!('tenantId' in data) || (data.tenantId is string && data.tenantId.size() <= 128))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Public clinic branding documents keyed by clinic slug
    match /clinics/{clinicId} {
      allow get: if isValidId(clinicId);
      allow list: if resource.data.slug is string && resource.data.slug.size() <= 128;
      allow create: if isValidId(clinicId)
        && isValidClinic(request.resource.data)
        && request.resource.data.slug == clinicId;
      allow update: if isValidId(clinicId)
        && isValidClinic(request.resource.data)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clinicName', 'doctorName', 'address', 'phone',
          'hotline', 'workingHours', 'workingHoursStr', 'slogan',
          'tenantId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // All internal, PII, auth, and clinical collections are server-managed (deny direct client SDK access)
    match /roles/{roleId} { allow read, write: if false; }
    match /users/{userId} { allow read, write: if false; }
    match /patients/{patientId} { allow read, write: if false; }
    match /providers/{providerId} { allow read, write: if false; }
    match /services/{serviceId} { allow read, write: if false; }
    match /appointments/{appointmentId} { allow read, write: if false; }
    match /appointment_holds/{holdId} { allow read, write: if false; }
    match /settings/{settingId} { allow read, write: if false; }
    match /patient_recalls/{recallId} { allow read, write: if false; }
    match /waitlist/{waitlistId} { allow read, write: if false; }
    match /audit_logs/{logId} { allow read, write: if false; }
    match /push_subscriptions/{subId} { allow read, write: if false; }
    match /provider_services/{psId} { allow read, write: if false; }
  }
}
